  "phrases": [
    { "id": "zh-essentials-01", "english": "Hello", "target": "你好", "romanization": "nǐ hǎo", "category": "essentials", "audio": null },
    { "id": "zh-essentials-02", "english": "Goodbye", "target": "再见", "romanization": "zài jiàn", "category": "essentials", "audio": null },
    { "id": "zh-essentials-03", "english": "Thank you", "target": "谢谢", "romanization": "xiè xie", "category": "essentials", "audio": null },
    { "id": "zh-essentials-04", "english": "You're welcome", "target": "不客气", "romanization": "bù kè qi", "category": "essentials", "audio": null },
    { "id": "zh-essentials-05", "english": "Please", "target": "请", "romanization": "qǐng", "category": "essentials", "audio": null },
    { "id": "zh-essentials-06", "english": "Sorry / Excuse me", "target": "对不起", "romanization": "duì bu qǐ", "category": "essentials", "audio": null },
    { "id": "zh-essentials-07", "english": "Yes", "target": "是", "romanization": "shì", "category": "essentials", "audio": null },
    { "id": "zh-essentials-08", "english": "No", "target": "不是", "romanization": "bù shì", "category": "essentials", "audio": null },
    { "id": "zh-essentials-09", "english": "Where is the toilet?", "target": "厕所在哪里?", "romanization": "cè suǒ zài nǎ lǐ?", "category": "essentials", "audio": null },
    { "id": "zh-essentials-10", "english": "Help!", "target": "救命!", "romanization": "jiù mìng!", "category": "essentials", "audio": null },
    { "id": "zh-essentials-11", "english": "Call the police", "target": "叫警察", "romanization": "jiào jǐng chá", "category": "essentials", "audio": null },
    { "id": "zh-essentials-12", "english": "I need a doctor", "target": "我需要医生", "romanization": "wǒ xū yào yī shēng", "category": "essentials", "audio": null },
    { "id": "zh-essentials-13", "english": "One", "target": "一", "romanization": "yī", "category": "essentials", "audio": null },
    { "id": "zh-essentials-14", "english": "Two", "target": "二", "romanization": "èr", "category": "essentials", "audio": null },
    { "id": "zh-essentials-15", "english": "How much is it?", "target": "多少钱?", "romanization": "duō shao qián?", "category": "essentials", "audio": null },

    { "id": "zh-ordering-01", "english": "I would like...", "target": "我要...", "romanization": "wǒ yào...", "category": "ordering", "audio": null },
    { "id": "zh-ordering-02", "english": "Menu, please", "target": "请给我菜单", "romanization": "qǐng gěi wǒ cài dān", "category": "ordering", "audio": null },
    { "id": "zh-ordering-03", "english": "What do you recommend?", "target": "你推荐什么?", "romanization": "nǐ tuī jiàn shén me?", "category": "ordering", "audio": null },
    { "id": "zh-ordering-04", "english": "One more, please", "target": "再来一个", "romanization": "zài lái yí gè", "category": "ordering", "audio": null },
    { "id": "zh-ordering-05", "english": "Water, please", "target": "请给我水", "romanization": "qǐng gěi wǒ shuǐ", "category": "ordering", "audio": null },
    { "id": "zh-ordering-06", "english": "Not spicy", "target": "不要辣", "romanization": "bú yào là", "category": "ordering", "audio": null },
    { "id": "zh-ordering-07", "english": "A little spicy", "target": "微辣", "romanization": "wēi là", "category": "ordering", "audio": null },
    { "id": "zh-ordering-08", "english": "Check, please", "target": "买单", "romanization": "mǎi dān", "category": "ordering", "audio": null },
    { "id": "zh-ordering-09", "english": "This is delicious", "target": "很好吃", "romanization": "hěn hǎo chī", "category": "ordering", "audio": null },
    { "id": "zh-ordering-10", "english": "Can I have chopsticks?", "target": "可以给我筷子吗?", "romanization": "kě yǐ gěi wǒ kuài zi ma?", "category": "ordering", "audio": null },
    { "id": "zh-ordering-11", "english": "Table for two", "target": "两位", "romanization": "liǎng wèi", "category": "ordering", "audio": null },
    { "id": "zh-ordering-12", "english": "Is this seat taken?", "target": "这个座位有人吗?", "romanization": "zhè gè zuò wèi yǒu rén ma?", "category": "ordering", "audio": null },
    { "id": "zh-ordering-13", "english": "I'm still deciding", "target": "我还在看", "romanization": "wǒ hái zài kàn", "category": "ordering", "audio": null },
    { "id": "zh-ordering-14", "english": "To go, please", "target": "打包", "romanization": "dǎ bāo", "category": "ordering", "audio": null },
    { "id": "zh-ordering-15", "english": "Fork, please", "target": "请给我叉子", "romanization": "qǐng gěi wǒ chā zi", "category": "ordering", "audio": null },

    { "id": "zh-dietary-01", "english": "I am vegetarian", "target": "我吃素", "romanization": "wǒ chī sù", "category": "dietary", "audio": null },
    { "id": "zh-dietary-02", "english": "I am vegan", "target": "我是严格素食者", "romanization": "wǒ shì yán gé sù shí zhě", "category": "dietary", "audio": null },
    { "id": "zh-dietary-03", "english": "I am allergic to peanuts", "target": "我对花生过敏", "romanization": "wǒ duì huā shēng guò mǐn", "category": "dietary", "audio": null },
    { "id": "zh-dietary-04", "english": "I am allergic to seafood", "target": "我对海鲜过敏", "romanization": "wǒ duì hǎi xiān guò mǐn", "category": "dietary", "audio": null },
    { "id": "zh-dietary-05", "english": "No meat, please", "target": "不要肉", "romanization": "bú yào ròu", "category": "dietary", "audio": null },
    { "id": "zh-dietary-06", "english": "No dairy, please", "target": "不要奶制品", "romanization": "bú yào nǎi zhì pǐn", "category": "dietary", "audio": null },
    { "id": "zh-dietary-07", "english": "No nuts, please", "target": "不要坚果", "romanization": "bú yào jiān guǒ", "category": "dietary", "audio": null },
    { "id": "zh-dietary-08", "english": "Does this contain pork?", "target": "这个有猪肉吗?", "romanization": "zhè gè yǒu zhū ròu ma?", "category": "dietary", "audio": null },
    { "id": "zh-dietary-09", "english": "Does this contain egg?", "target": "这个有鸡蛋吗?", "romanization": "zhè gè yǒu jī dàn ma?", "category": "dietary", "audio": null },
    { "id": "zh-dietary-10", "english": "I can't eat gluten", "target": "我不能吃麸质", "romanization": "wǒ bù néng chī fū zhì", "category": "dietary", "audio": null },
    { "id": "zh-dietary-11", "english": "Is this spicy?", "target": "这个辣吗?", "romanization": "zhè gè là ma?", "category": "dietary", "audio": null },
    { "id": "zh-dietary-12", "english": "I am diabetic", "target": "我有糖尿病", "romanization": "wǒ yǒu táng niào bìng", "category": "dietary", "audio": null },
    { "id": "zh-dietary-13", "english": "I don't eat shellfish", "target": "我不吃贝类", "romanization": "wǒ bù chī bèi lèi", "category": "dietary", "audio": null },
    { "id": "zh-dietary-14", "english": "Low sugar, please", "target": "少糖", "romanization": "shǎo táng", "category": "dietary", "audio": null },
    { "id": "zh-dietary-15", "english": "No ice, please", "target": "不要冰", "romanization": "bú yào bīng", "category": "dietary", "audio": null },

    { "id": "zh-paying-01", "english": "How much in total?", "target": "一共多少钱?", "romanization": "yí gòng duō shao qián?", "category": "paying", "audio": null },
    { "id": "zh-paying-02", "english": "Can I pay by card?", "target": "可以刷卡吗?", "romanization": "kě yǐ shuā kǎ ma?", "category": "paying", "audio": null },
    { "id": "zh-paying-03", "english": "Cash only?", "target": "只收现金吗?", "romanization": "zhǐ shōu xiàn jīn ma?", "category": "paying", "audio": null },
    { "id": "zh-paying-04", "english": "Do you accept Alipay?", "target": "可以用支付宝吗?", "romanization": "kě yǐ yòng zhī fù bǎo ma?", "category": "paying", "audio": null },
    { "id": "zh-paying-05", "english": "Do you accept WeChat Pay?", "target": "可以用微信支付吗?", "romanization": "kě yǐ yòng wēi xìn zhī fù ma?", "category": "paying", "audio": null },
    { "id": "zh-paying-06", "english": "Can I get a receipt?", "target": "可以给我收据吗?", "romanization": "kě yǐ gěi wǒ shōu jù ma?", "category": "paying", "audio": null },
    { "id": "zh-paying-07", "english": "Is service charge included?", "target": "包括服务费吗?", "romanization": "bāo kuò fú wù fèi ma?", "category": "paying", "audio": null },
    { "id": "zh-paying-08", "english": "That's too expensive", "target": "太贵了", "romanization": "tài guì le", "category": "paying", "audio": null },
    { "id": "zh-paying-09", "english": "Can you lower the price?", "target": "可以便宜一点吗?", "romanization": "kě yǐ pián yí yì diǎn ma?", "category": "paying", "audio": null },
    { "id": "zh-paying-10", "english": "Keep the change", "target": "不用找了", "romanization": "bú yòng zhǎo le", "category": "paying", "audio": null },
    { "id": "zh-paying-11", "english": "I don't have small change", "target": "我没有零钱", "romanization": "wǒ méi yǒu líng qián", "category": "paying", "audio": null },
    { "id": "zh-paying-12", "english": "Split the bill, please", "target": "分开付", "romanization": "fēn kāi fù", "category": "paying", "audio": null },
    { "id": "zh-paying-13", "english": "I'll pay for everyone", "target": "我请大家", "romanization": "wǒ qǐng dà jiā", "category": "paying", "audio": null },
    { "id": "zh-paying-14", "english": "Discount?", "target": "打折吗?", "romanization": "dǎ zhé ma?", "category": "paying", "audio": null },
    { "id": "zh-paying-15", "english": "Where do I pay?", "target": "在哪里付钱?", "romanization": "zài nǎ lǐ fù qián?", "category": "paying", "audio": null },

    { "id": "zh-transport-01", "english": "One ticket, please", "target": "买一张票", "romanization": "mǎi yì zhāng piào", "category": "transport", "audio": null },
    { "id": "zh-transport-02", "english": "How much is a ticket to...?", "target": "到...的票多少钱?", "romanization": "dào...de piào duō shao qián?", "category": "transport", "audio": null },
    { "id": "zh-transport-03", "english": "Which platform?", "target": "哪个站台?", "romanization": "nǎ gè zhàn tái?", "category": "transport", "audio": null },
    { "id": "zh-transport-04", "english": "Is this seat free?", "target": "这个座位空着吗?", "romanization": "zhè gè zuò wèi kòng zhe ma?", "category": "transport", "audio": null },
    { "id": "zh-transport-05", "english": "Please take me to this address", "target": "请带我去这个地址", "romanization": "qǐng dài wǒ qù zhè gè dì zhǐ", "category": "transport", "audio": null },
    { "id": "zh-transport-06", "english": "Please stop here", "target": "请在这里停", "romanization": "qǐng zài zhè lǐ tíng", "category": "transport", "audio": null },
    { "id": "zh-transport-07", "english": "How long does it take?", "target": "需要多长时间?", "romanization": "xū yào duō cháng shí jiān?", "category": "transport", "audio": null },
    { "id": "zh-transport-08", "english": "Is this the right bus?", "target": "这是对的公交车吗?", "romanization": "zhè shì duì de gōng jiāo chē ma?", "category": "transport", "audio": null },
    { "id": "zh-transport-09", "english": "Where is the nearest subway station?", "target": "最近的地铁站在哪里?", "romanization": "zuì jìn de dì tiě zhàn zài nǎ lǐ?", "category": "transport", "audio": null },
    { "id": "zh-transport-10", "english": "I missed my stop", "target": "我坐过站了", "romanization": "wǒ zuò guò zhàn le", "category": "transport", "audio": null },
    { "id": "zh-transport-11", "english": "Can you use the meter?", "target": "可以打表吗?", "romanization": "kě yǐ dǎ biǎo ma?", "category": "transport", "audio": null },
    { "id": "zh-transport-12", "english": "I need to go to the airport", "target": "我要去机场", "romanization": "wǒ yào qù jī chǎng", "category": "transport", "audio": null },
    { "id": "zh-transport-13", "english": "Is there a direct train?", "target": "有直达的火车吗?", "romanization": "yǒu zhí dá de huǒ chē ma?", "category": "transport", "audio": null },
    { "id": "zh-transport-14", "english": "Please wait a moment", "target": "请等一下", "romanization": "qǐng děng yí xià", "category": "transport", "audio": null },
    { "id": "zh-transport-15", "english": "Last stop?", "target": "终点站吗?", "romanization": "zhōng diǎn zhàn ma?", "category": "transport", "audio": null },

    { "id": "zh-directions-01", "english": "Where am I?", "target": "我在哪里?", "romanization": "wǒ zài nǎ lǐ?", "category": "directions", "audio": null },
    { "id": "zh-directions-02", "english": "How do I get to...?", "target": "怎么去...?", "romanization": "zěn me qù...?", "category": "directions", "audio": null },
    { "id": "zh-directions-03", "english": "Is it far?", "target": "远吗?", "romanization": "yuǎn ma?", "category": "directions", "audio": null },
    { "id": "zh-directions-04", "english": "Turn left", "target": "左转", "romanization": "zuǒ zhuǎn", "category": "directions", "audio": null },
    { "id": "zh-directions-05", "english": "Turn right", "target": "右转", "romanization": "yòu zhuǎn", "category": "directions", "audio": null },
    { "id": "zh-directions-06", "english": "Go straight", "target": "直走", "romanization": "zhí zǒu", "category": "directions", "audio": null },
    { "id": "zh-directions-07", "english": "It's near here", "target": "就在附近", "romanization": "jiù zài fù jìn", "category": "directions", "audio": null },
    { "id": "zh-directions-08", "english": "Can you show me on the map?", "target": "可以在地图上指给我看吗?", "romanization": "kě yǐ zài dì tú shàng zhǐ gěi wǒ kàn ma?", "category": "directions", "audio": null },
    { "id": "zh-directions-09", "english": "I'm lost", "target": "我迷路了", "romanization": "wǒ mí lù le", "category": "directions", "audio": null },
    { "id": "zh-directions-10", "english": "Is there a shortcut?", "target": "有近路吗?", "romanization": "yǒu jìn lù ma?", "category": "directions", "audio": null },
    { "id": "zh-directions-11", "english": "Which way is north?", "target": "哪个方向是北?", "romanization": "nǎ gè fāng xiàng shì běi?", "category": "directions", "audio": null },
    { "id": "zh-directions-12", "english": "How many minutes on foot?", "target": "走路要多少分钟?", "romanization": "zǒu lù yào duō shao fēn zhōng?", "category": "directions", "audio": null },
    { "id": "zh-directions-13", "english": "Cross the street", "target": "过马路", "romanization": "guò mǎ lù", "category": "directions", "audio": null },
    { "id": "zh-directions-14", "english": "It's on the second floor", "target": "在二楼", "romanization": "zài èr lóu", "category": "directions", "audio": null },
    { "id": "zh-directions-15", "english": "Excuse me, can you help me?", "target": "打扰一下,你能帮我吗?", "romanization": "dǎ rǎo yí xià, nǐ néng bāng wǒ ma?", "category": "directions", "audio": null },

    { "id": "zh-accommodation-01", "english": "I have a reservation", "target": "我有预订", "romanization": "wǒ yǒu yù dìng", "category": "accommodation", "audio": null },
    { "id": "zh-accommodation-02", "english": "Check-in, please", "target": "我要入住", "romanization": "wǒ yào rù zhù", "category": "accommodation", "audio": null },
    { "id": "zh-accommodation-03", "english": "Check-out, please", "target": "我要退房", "romanization": "wǒ yào tuì fáng", "category": "accommodation", "audio": null },
    { "id": "zh-accommodation-04", "english": "What time is checkout?", "target": "退房时间是几点?", "romanization": "tuì fáng shí jiān shì jǐ diǎn?", "category": "accommodation", "audio": null },
    { "id": "zh-accommodation-05", "english": "Can I get an extra towel?", "target": "可以多给一条毛巾吗?", "romanization": "kě yǐ duō gěi yì tiáo máo jīn ma?", "category": "accommodation", "audio": null },
    { "id": "zh-accommodation-06", "english": "The Wi-Fi password, please", "target": "请给我无线网密码", "romanization": "qǐng gěi wǒ wú xiàn wǎng mì mǎ", "category": "accommodation", "audio": null },
    { "id": "zh-accommodation-07", "english": "Is breakfast included?", "target": "包含早餐吗?", "romanization": "bāo hán zǎo cān ma?", "category": "accommodation", "audio": null },
    { "id": "zh-accommodation-08", "english": "My room key doesn't work", "target": "我的房卡不能用", "romanization": "wǒ de fáng kǎ bù néng yòng", "category": "accommodation", "audio": null },
    { "id": "zh-accommodation-09", "english": "Can I have a late checkout?", "target": "可以晚一点退房吗?", "romanization": "kě yǐ wǎn yì diǎn tuì fáng ma?", "category": "accommodation", "audio": null },
    { "id": "zh-accommodation-10", "english": "Is there air conditioning?", "target": "有空调吗?", "romanization": "yǒu kōng tiáo ma?", "category": "accommodation", "audio": null },
    { "id": "zh-accommodation-11", "english": "Can you call a taxi for me?", "target": "可以帮我叫出租车吗?", "romanization": "kě yǐ bāng wǒ jiào chū zū chē ma?", "category": "accommodation", "audio": null },
    { "id": "zh-accommodation-12", "english": "Can I store my luggage?", "target": "可以存行李吗?", "romanization": "kě yǐ cún xíng lǐ ma?", "category": "accommodation", "audio": null },
    { "id": "zh-accommodation-13", "english": "The room is too cold", "target": "房间太冷了", "romanization": "fáng jiān tài lěng le", "category": "accommodation", "audio": null },
    { "id": "zh-accommodation-14", "english": "The room is too hot", "target": "房间太热了", "romanization": "fáng jiān tài rè le", "category": "accommodation", "audio": null },
    { "id": "zh-accommodation-15", "english": "Is there hot water?", "target": "有热水吗?", "romanization": "yǒu rè shuǐ ma?", "category": "accommodation", "audio": null },

    { "id": "zh-shopping-01", "english": "How much is this?", "target": "这个多少钱?", "romanization": "zhè gè duō shao qián?", "category": "shopping", "audio": null },
    { "id": "zh-shopping-02", "english": "Can I try it on?", "target": "可以试穿吗?", "romanization": "kě yǐ shì chuān ma?", "category": "shopping", "audio": null },
    { "id": "zh-shopping-03", "english": "Do you have a bigger size?", "target": "有大一点的尺码吗?", "romanization": "yǒu dà yì diǎn de chǐ mǎ ma?", "category": "shopping", "audio": null },
    { "id": "zh-shopping-04", "english": "Do you have a smaller size?", "target": "有小一点的尺码吗?", "romanization": "yǒu xiǎo yì diǎn de chǐ mǎ ma?", "category": "shopping", "audio": null },
    { "id": "zh-shopping-05", "english": "Do you have another color?", "target": "有别的颜色吗?", "romanization": "yǒu bié de yán sè ma?", "category": "shopping", "audio": null },
    { "id": "zh-shopping-06", "english": "I'm just looking", "target": "我只是看看", "romanization": "wǒ zhǐ shì kàn kàn", "category": "shopping", "audio": null },
    { "id": "zh-shopping-07", "english": "Can you give me a discount?", "target": "可以便宜一点吗?", "romanization": "kě yǐ pián yí yì diǎn ma?", "category": "shopping", "audio": null },
    { "id": "zh-shopping-08", "english": "Do you have a bag?", "target": "有袋子吗?", "romanization": "yǒu dài zi ma?", "category": "shopping", "audio": null },
    { "id": "zh-shopping-09", "english": "I'll take this one", "target": "我要这个", "romanization": "wǒ yào zhè gè", "category": "shopping", "audio": null },
    { "id": "zh-shopping-10", "english": "Can I return this?", "target": "可以退货吗?", "romanization": "kě yǐ tuì huò ma?", "category": "shopping", "audio": null },
    { "id": "zh-shopping-11", "english": "Where is the fitting room?", "target": "试衣间在哪里?", "romanization": "shì yī jiān zài nǎ lǐ?", "category": "shopping", "audio": null },
    { "id": "zh-shopping-12", "english": "Is this handmade?", "target": "这是手工做的吗?", "romanization": "zhè shì shǒu gōng zuò de ma?", "category": "shopping", "audio": null },
    { "id": "zh-shopping-13", "english": "Can you wrap it as a gift?", "target": "可以包装成礼物吗?", "romanization": "kě yǐ bāo zhuāng chéng lǐ wù ma?", "category": "shopping", "audio": null },
